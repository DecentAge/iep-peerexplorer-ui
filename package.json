{
  "name": "iep-peerexplorer-ui",
  "version": "0.0.0",
  "scripts": {
    "prestart": "npm install",
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 80 --disable-host-check",
    "build": "ng build --configuration=production --base-href /peerexplorer/ --deploy-url /peerexplorer/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker build -t iep-peerexplorer-ui .",
    "docker:run": "docker run -p 4200:80 iep-peerexplorer-ui",
    "docker:compose": "docker-compose up -d",
    "docker:compose:build": "docker-compose up -d --build",
    "docker:stop": "docker-compose down"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@ng-bootstrap/ng-bootstrap": "^15.1.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular/cli": "~16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sass": "^1.58.3",
    "typescript": "~5.1.3"
  }
}
