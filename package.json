{
  "name": "iep-peerexplorer-ui",
  "version": "0.3.3",
  "scripts": {
    "prestart": "npm install",
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 80 --disable-host-check",
    "build": "ng build --configuration=production --base-href /peerexplorer/ --deploy-url /peerexplorer/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker build -t iep-peerexplorer-ui .",
    "docker:run": "docker run -p 4200:80 iep-peerexplorer-ui",
    "docker:compose": "docker-compose up -d",
    "docker:compose:build": "docker-compose up -d --build",
    "docker:stop": "docker-compose down"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/localize": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sass": "^1.90.0",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": "^22.0.0"
  }
}
